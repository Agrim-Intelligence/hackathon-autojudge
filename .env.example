# =============================================================================
# Agrim AutoJudge — environment configuration
#
# This file is the ONLY way to route requests between providers. There is no
# run-mode flag in code. Edit `AUTOJUDGE_PRIMARY_PROVIDER` to switch providers.
#
# IMPORTANT: After editing this file you MUST restart the Streamlit form and
# the dashboard (Ctrl+C and re-run the streamlit commands). The CLI picks up
# changes on every invocation; long-running Streamlit processes do not.
# =============================================================================

# -----------------------------------------------------------------------------
# API keys
#
# GITHUB_TOKEN is STRONGLY RECOMMENDED. Unauthenticated GitHub allows only 60
# requests/hour per IP; the pipeline (snapshot download + metrics + commit
# history) easily exceeds that across a single batch. With a fine-grained PAT
# (Contents:Read, Metadata:Read) the limit rises to 5000/hr. When missing,
# the pipeline raises GitHubRateLimitError immediately instead of silently
# blocking on PyGithub's 9-minute backoff.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Provider routing
# Options for both: groq | gemini | openrouter | anthropic
#
# Recommended .env recipes:
#   - Free dev / smoke tests:
#       AUTOJUDGE_PRIMARY_PROVIDER=groq
#       AUTOJUDGE_FALLBACK_PROVIDER=
#   - Production judging (Anthropic prompt caching + tool-calling enabled):
#       AUTOJUDGE_PRIMARY_PROVIDER=anthropic
#       AUTOJUDGE_FALLBACK_PROVIDER=groq
# -----------------------------------------------------------------------------
AUTOJUDGE_PRIMARY_PROVIDER=anthropic
AUTOJUDGE_FALLBACK_PROVIDER=groq

# -----------------------------------------------------------------------------
# Models per provider (reasoning = heavy, extraction = cheap)
# -----------------------------------------------------------------------------
AUTOJUDGE_GROQ_REASONING_MODEL=llama-3.3-70b-versatile
AUTOJUDGE_GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant

AUTOJUDGE_GEMINI_REASONING_MODEL=gemini-2.5-pro
AUTOJUDGE_GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

AUTOJUDGE_OPENROUTER_REASONING_MODEL=anthropic/claude-sonnet-4.5
AUTOJUDGE_OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini

AUTOJUDGE_ANTHROPIC_REASONING_MODEL=claude-sonnet-4-20250514
AUTOJUDGE_ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# OpenRouter attribution (recommended)
# -----------------------------------------------------------------------------
AUTOJUDGE_OPENROUTER_REFERER=https://agrim.ai
AUTOJUDGE_OPENROUTER_TITLE=Agrim AutoJudge

# -----------------------------------------------------------------------------
# Hackathon window (used for commit-timestamp integrity check)
# -----------------------------------------------------------------------------
AUTOJUDGE_HACKATHON_START=2026-05-22T00:00:00+05:30
AUTOJUDGE_HACKATHON_END=2026-05-23T23:59:59+05:30

# -----------------------------------------------------------------------------
# Local paths and browser settings
# -----------------------------------------------------------------------------
AUTOJUDGE_DATA_DIR=./data
AUTOJUDGE_DB_PATH=./data/traces.db
AUTOJUDGE_BROWSER_HEADLESS=true
AUTOJUDGE_BROWSER_TIMEOUT_S=45
AUTOJUDGE_BROWSER_MAX_STEPS=12

# -----------------------------------------------------------------------------
# Operability
#
# AUTOJUDGE_SUBMISSION_TIMEOUT_S: per-submission wall-clock cap. When exceeded,
# the orchestrator short-circuits to the rubric scorer with whatever reports
# have already been produced and flags `submission_timeout` on the result.
# Avoids a single hung browser session blocking a 50-submission batch.
#
# AUTOJUDGE_SNAPSHOT_TTL_DAYS: how old a snapshot.tar.gz can be before
# `autojudge gc` evicts it. Snapshots cost ~3-50 MB each; a 14-day window
# preserves cross-day re-runs while keeping the volume tidy.
# -----------------------------------------------------------------------------
AUTOJUDGE_SUBMISSION_TIMEOUT_S=900
AUTOJUDGE_SNAPSHOT_TTL_DAYS=14

# -----------------------------------------------------------------------------
# Streamlit basic auth (MVP front door)
#
# Until Cloudflare Access is wired up (Phase 2 hardening), both Streamlit
# surfaces lock themselves with a shared username/password pair when these
# env vars are set. Leave either USER or PASS empty to disable auth for
# that role (useful for local dev or for opening the intake form to
# candidates during the hackathon window).
#
# - DASHBOARD: internal judges. Set both in production.
# - INTAKE:    candidate submission form. Often left empty during the
#              hackathon and re-locked after.
#
# The dashboard's override audit trail (`overridden_by`) records whichever
# username signed in, so generate one shared credential per judging session
# if you need rough attribution.
# -----------------------------------------------------------------------------
AUTOJUDGE_DASHBOARD_BASIC_AUTH_USER=
AUTOJUDGE_DASHBOARD_BASIC_AUTH_PASS=
AUTOJUDGE_INTAKE_BASIC_AUTH_USER=
AUTOJUDGE_INTAKE_BASIC_AUTH_PASS=

# -----------------------------------------------------------------------------
# Shared backing store
#
# Leave ``DATABASE_URL`` unset for local SQLite at AUTOJUDGE_DB_PATH (single-
# machine dev). Set it (e.g. Railway's auto-provisioned Postgres URL,
# ``postgresql://user:pass@host:port/db``) to use Postgres — required when
# the intake form and the judges' dashboard run as separate Railway
# services and must share submissions, scores, and deck blobs.
#
# Both backends honour the same Python API (TraceStoreProtocol); switching
# is a pure env change. ``autojudge doctor`` reports the active backend.
# -----------------------------------------------------------------------------
DATABASE_URL=
